# Copy to .env and adjust. Never commit .env.
JOBSIGNAL_DATABASE_URL=sqlite:///jobsignal.db
JOBSIGNAL_LOG_LEVEL=INFO
# API (scripts/run_api.py). A key is REQUIRED to bind beyond localhost; leave empty locally.
JOBSIGNAL_API_KEY=
# Comma-separated browser origins allowed by CORS; empty = CORS off.
JOBSIGNAL_API_CORS_ORIGINS=
# Dashboard: where the API lives (http/https only)
JOBSIGNAL_API_URL=http://127.0.0.1:8000
